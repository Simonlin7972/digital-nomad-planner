{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "account.signOut": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウト"
          }
        }
      }
    },
    "app.name": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天不在家工作"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not WFH"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は在宅じゃない"
          }
        }
      }
    },
    "list.empty": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在電腦上排好並登入同一個 Google 帳號後，這裡就會出現。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan on a computer signed in to the same Google account and it shows up here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ Google アカウントでログインした PC で計画すると、ここに表示されます。"
          }
        }
      }
    },
    "list.emptyTitle": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有行程"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing planned yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ予定がありません"
          }
        }
      }
    },
    "list.past %lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已結束的 %lld 段"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了した滞在 %lld 件"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld past stay"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld past stays"
                }
              }
            }
          }
        }
      }
    },
    "list.upcoming": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これから"
          }
        }
      }
    },
    "mobile.dayOf %lld %lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld / %2$lld 天"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day %1$lld of %2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 日中 %1$lld 日目"
          }
        }
      }
    },
    "mobile.daysLeft %lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還有 %lld 天"
          }
        },
        "ja": {
