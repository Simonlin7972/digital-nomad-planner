    "mobile.next": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一站"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次"
          }
        }
      }
    },
    "mobile.now": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在"
          }
        }
      }
    },
    "mobile.travelToday": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天移動"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "travel day today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日が移動日"
          }
        }
      }
    },
    "rules.schengen %lld %lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "申根：最近 180 天內 %1$lld / %2$lld 天"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schengen: %1$lld of %2$lld days in the last 180"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェンゲン：直近 180 日で %1$lld / %2$lld 日"
          }
        }
      }
    },
    "signin.body": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Google 登入，看電腦上排好的行程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Google to see the plan made on your computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google でログインして、PC で作ったプランを見る。"
          }
        }
      }
    },
    "signin.button": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Google 登入"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Google"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google でログイン"
          }
        }
      }
    },
    "signin.readOnly": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上只能瀏覽。要排行程或修改，請用電腦打開。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone only shows the plan. To plan or change it, open it on a computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホでは閲覧のみ。計画や変更は PC で開いてください。"
          }
        }
      }
    },
    "unit.days %lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days"
                }
              }
            }
          }
        }
      }
