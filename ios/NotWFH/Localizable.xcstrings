              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days to go"
                }
              }
            }
          }
        }
      }
    },
    "mobile.inDays %lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天後出發"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日後に出発"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "leaving in %lld day"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "leaving in %lld days"
                }
              }
            }
